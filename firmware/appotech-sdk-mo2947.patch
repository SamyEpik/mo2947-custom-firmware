+#ifndef APPOTECH_BOARD_H
+#define APPOTECH_BOARD_H
+#define APX_BOARD_SILVERGEAR 0
+#define APX_BOARD_ID "mo2947"
+#define APX_CAMERA_COUNT 1u
+#define APX_HAS_PRINTER 0
