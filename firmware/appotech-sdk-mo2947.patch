index 0000000..87efd7a
--- /dev/null
+++ b/examples/mo2947-camera/main.c
@@ -0,0 +1,127 @@
+/* MO2947 combined test image: everything in one flash install.
+ * Base: the SDK's Action camera app (live preview; every subsystem reachable over the USB debug link with
+ * tools/mo2947_apxd.py: STORAGE, CAMERA, JPEG, AUDIO, MICROPHONE, BATTERY, SPI).
+ * Keys on the camera (each action is logged; read with "mo2947_apxd.py log"):
+ *   SHUTTER         photo 640x480 -> SD 0:/MO_nnnn.JPG (new files only)
+ *   UP              speaker tone 880 Hz
+ *   DOWN            record 2 s (16 kHz), play it back, save 0:/MO_nnnn.WAV
+ *   RIGHT           battery voltage to the log
+ *   hold LEFT 2 s   boot ROM USB loader (reflash)
+ *   hold POWER 2 s  power off (after releasing it once)
+ * Beeps: short high = done, long low = failed. Hold SHUTTER at power-on: loader (early escape, before the SDK). */
+#include <appotech/soc.h>
+#include "board.h"
+#include <appotech/usb.h>
+#include <appotech/debug.h>
+#include <appotech/display.h>
+#include <appotech/buttons.h>
+#include <appotech/power.h>
+#include <appotech/audio_files.h>
+#include <appotech/microphone_files.h>
+#include <appotech/microphone.h>
+#include <appotech/camera_files.h>
+#include <appotech/uart.h>
+#include <appotech/battery.h>
+#include <appotech/spi.h>
+#include <appotech/trace.h>
+#include <appotech/storage.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef uint32_t (*command_fn)(unsigned,const uint8_t *,size_t,uint8_t *,size_t *);
+static uint8_t reply[APXD_MAX_PAYLOAD+1];
+static uint32_t command(command_fn f,unsigned c,const void *in,size_t len) {
+    size_t n=0;uint32_t r=f(c,(const uint8_t *)in,len,reply,&n);
+    reply[n<APXD_MAX_PAYLOAD?n:APXD_MAX_PAYLOAD]=0;return r;
+}
+static void put32(uint8_t *p,uint32_t v){p[0]=v;p[1]=v>>8;p[2]=v>>16;p[3]=v>>24;}
+static void service(void) {
+    apx_debug_poll();apx_uart_poll();apx_buttons_poll();apx_battery_poll();apx_display_poll();apx_camera_files_poll();apx_maintenance();
+}
+static void pause_ms(uint32_t ms) { uint32_t end=apx_ticks()+ms*33u; while(!apx_deadline_expired(end))service(); }
+static void tone(unsigned hz,unsigned ms) {
+    uint8_t in[12];put32(in,hz);put32(in+4,ms);put32(in+8,16000);
+    uint32_t r=command(apx_audio_command,1,in,12);if(r)printf("tone %u Hz: error %#lx\n",hz,(unsigned long)r);
+}
+static void result_beep(int ok) { if(ok)tone(2000,80);else tone(300,400); }
+/* Wait until the subsystem's INFO JSON contains `done` (or `fail`), servicing everything meanwhile. */
+static int wait_info(command_fn f,const char *done,const char *fail,uint32_t ms) {
+    uint32_t end=apx_ticks()+ms*33u;
+    while(!apx_deadline_expired(end)) {
+        service();command(f,0,NULL,0);
+        if(strstr((char *)reply,done))return 0;
+        if(fail&&strstr((char *)reply,fail))return -1;
+    }
+    return -2;
+}
+static unsigned file_number=1;
+static uint32_t save_new(command_fn f,unsigned save_command,const char *extension,char *path) {
+    for(unsigned tries=0;tries<1000;++tries,++file_number) {
+        snprintf(path,32,"0:/MO_%04u.%s",file_number,extension);
+        uint32_t r=command(f,save_command,path,strlen(path)+1);
+        if(r!=0x108u)return r;       /* 0x100+FR_EXIST: name taken, try the next one */
+    }
+    return 0x108u;
+}
+static void photo(void) {
+    uint8_t in[12];put32(in,640);put32(in+4,480);put32(in+8,8);
+    uint32_t r=command(apx_camera_command,2,in,12);
+    if(r){printf("photo: capture start error %#lx\n",(unsigned long)r);result_beep(0);return;}
+    int w=wait_info(apx_camera_command,"\"job\":4,","\"job\":5,",15000);
+    if(w){printf("photo: capture %s: %s\n",w==-2?"timeout":"failed",(char *)reply);result_beep(0);}
+    else {
+        char path[32];r=save_new(apx_camera_command,4,"JPG",path);
+        printf("photo: %s %s (%#lx)\n",path,r?"save failed":"saved",(unsigned long)r);result_beep(!r);
+    }
+    uint8_t on[4];put32(on,1);r=command(apx_camera_command,1,on,4);
+    if(r)printf("photo: preview restart error %#lx\n",(unsigned long)r);
+}
+static void recording(void) {
+    uint8_t in[8];put32(in,64000);put32(in+4,16000);
+    uint32_t r=command(apx_microphone_command,1,in,8);
+    if(r){printf("mic: start error %#lx\n",(unsigned long)r);result_beep(0);return;}
+    printf("mic: recording 2 s\n");
+    int w=wait_info(apx_microphone_command,"\"state\":3,","\"state\":4,",4000);
+    if(w){printf("mic: %s: %s\n",w==-2?"timeout":"failed",(char *)reply);result_beep(0);return;}
+    r=command(apx_microphone_command,5,NULL,0);
+    printf("mic: playback %s (%#lx)\n",r?"failed":"started",(unsigned long)r);
+    pause_ms(2300);
+    char path[32];r=save_new(apx_microphone_command,4,"WAV",path);
+    printf("mic: %s %s (%#lx)\n",path,r?"save failed":"saved",(unsigned long)r);result_beep(!r);
+}
+static void battery(void) {
+    struct apx_battery_info b;apx_battery_get_info(&b);
+    printf("battery: %lu mV valid %u level %u external %u adc %u/%u cal %u\n",(unsigned long)b.millivolts,b.valid,b.level,
+           b.external_power,b.adc_battery,b.adc_reference,b.calibration);
+    result_beep(b.valid);
+}
+int main(void) {
+    apx_trace(APX_TRACE_MAIN,0);
+    apx_usb_init();apx_buttons_init();apx_display_init();
+    int battery_error=apx_battery_init(),spi=apx_spi_init();
+    int audio=apx_audio_files_init(),mic=apx_microphone_files_init(),camera=apx_camera_files_init();
+    FRESULT sd=apx_storage_mount();
+    printf("MO2947 camera test, board %s\n",APX_BOARD_NAME);
+    printf("init: battery %d spi %d speaker %d microphone %d camera %d sd %d\n",battery_error,spi,audio,mic,camera,(int)sd);
+    command(apx_camera_command,0,NULL,0);printf("camera: %s\n",(char *)reply);
+    apx_led_set(1);
+    tone(1000,120);
+    uint32_t held_since=0,shown=0;unsigned power_armed=0,acted=0;
+    for(;;) {
+        service();
+        struct apx_button_event e;
+        while(apx_buttons_next(&e)) {
+            if(e.pressed&APX_BUTTON_SHUTTER)photo();
+            if(e.pressed&APX_BUTTON_UP)tone(880,300);
+            if(e.pressed&APX_BUTTON_DOWN)recording();
+            if(e.pressed&APX_BUTTON_RIGHT)battery();
+        }
+        struct apx_buttons_info b;apx_buttons_get_info(&b);
+        if(!(b.state&APX_BUTTON_POWER))power_armed=1;
+        if(b.state!=shown){shown=b.state;held_since=apx_ticks();acted=0;}
+        uint32_t held=apx_ticks()-held_since;
+        if(!acted&&shown==APX_BUTTON_LEFT&&held>65536u){acted=1;printf("LEFT held: boot ROM loader\n");apx_bootrom();}
+        if(!acted&&shown==APX_BUTTON_POWER&&power_armed&&held>65536u){acted=1;printf("POWER held: off\n");
+            uint32_t r=apx_power_off();printf("power off failed %#lx\n",(unsigned long)r);}
+    }
+}
diff --git a/examples/mo2947-demo/main.c b/examples/mo2947-demo/main.c
new file mode 100644
index 0000000..2cfa43d
--- /dev/null
+++ b/examples/mo2947-demo/main.c
@@ -0,0 +1,60 @@
+/* MO2947 first SDK image: display (NV3030B through the 240x320 driver), buttons, LED, USB debug link.
+ * Colour bars, a red square at logical (0,0) to check the rotation, a centre square per key.
+ * Hold SHUTTER 2 s -> boot ROM USB loader (reflash). Hold POWER 2 s (after releasing it once) -> power off.
+ * The SDK's own cold-boot recovery also enters the loader when SHUTTER is held at power-on. */
+#include <appotech/soc.h>
+#include <appotech/display.h>
+#include <appotech/buttons.h>
+#include <appotech/usb.h>
+#include <appotech/debug.h>
+#include <appotech/power.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "board.h"
+
+static void service(void) { apx_display_poll(); apx_buttons_poll(); apx_debug_poll(); }
+static int wait_display(void) {
+    while(apx_display_status()==APX_DISPLAY_BUSY||apx_display_status()==APX_DISPLAY_INITIALIZING)service();
+    return apx_display_status()==APX_DISPLAY_READY?0:-1;
+}
+static void fill(unsigned x,unsigned y,unsigned w,unsigned h,uint16_t c) {
+    if(!apx_display_fill(x,y,w,h,c))wait_display();
+}
+static uint16_t key_colour(uint32_t state) {
+    if(state&APX_BUTTON_SHUTTER)return 0xffff;   /* white */
+    if(state&APX_BUTTON_UP)return 0xf800;        /* red */
+    if(state&APX_BUTTON_DOWN)return 0x001f;      /* blue */
+    if(state&APX_BUTTON_LEFT)return 0x07e0;      /* green */
+    if(state&APX_BUTTON_RIGHT)return 0xffe0;     /* yellow */
+    if(state&APX_BUTTON_POWER)return 0xf81f;     /* magenta */
+    return 0x8410;                               /* grey */
+}
+int main(void) {
+    printf("MO2947 SDK demo, board %s\n",APX_BOARD_NAME);
+    apx_buttons_init();
+    apx_led_set(1);
+    apx_usb_init();
+    apx_display_init();
+    if(wait_display()) {
+        printf("display error\n");
+        for(uint32_t t=0;;++t) { apx_led_set((t>>12)&1); service(); }
+    }
+    unsigned w=apx_display_width(),h=apx_display_height();
+    static const uint16_t bars[8]={0xffff,0xffe0,0x07ff,0x07e0,0xf81f,0xf800,0x001f,0x0000};
+    for(unsigned i=0;i<8;++i)fill(i*w/8,0,w/8,h,bars[i]);
+    fill(0,0,30,30,0xf800);                     /* orientation: logical (0,0) should be top left */
+    printf("display %ux%u ready\n",w,h);
+
+    uint32_t shown=~0u,held_since=apx_ticks(),blink=apx_ticks();
+    int power_armed=0,led=1;
+    for(;;) {
+        service();
+        struct apx_buttons_info info;apx_buttons_get_info(&info);
+        if(info.state!=shown) { shown=info.state;held_since=apx_ticks();fill(w/2-50,h/2-50,100,100,key_colour(shown)); }
+        if(!(shown&APX_BUTTON_POWER))power_armed=1;
+        uint32_t held=apx_ticks()-held_since;
+        if(shown==APX_BUTTON_SHUTTER&&held>2u*32768u) { printf("SHUTTER held: boot ROM loader\n");apx_bootrom(); }
+        if(shown==APX_BUTTON_POWER&&power_armed&&held>2u*32768u) { printf("POWER held: off\n");apx_power_off(); }
+        if(apx_ticks()-blink>16384u) { blink=apx_ticks();led=!led;apx_led_set(led); }
+    }
+}
