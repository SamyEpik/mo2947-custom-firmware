+            (address>=APX_EXTRA_RAM_BASE || length>APX_EXTRA_RAM_BASE-address)) ||
+           ((uintptr_t)__large_buffer_end>(uintptr_t)__large_buffer_start && address<APX_LOW_RAM_END &&
+            (address>=APX_LOW_RAM_BASE || length>APX_LOW_RAM_BASE-address)) ||
+           ((uintptr_t)__jpeg_buffer_end>(uintptr_t)__jpeg_buffer_start && address<APX_CODEC_RAM_END &&
+            (address>=APX_CODEC_RAM_BASE || length>APX_CODEC_RAM_BASE-address));
 }
