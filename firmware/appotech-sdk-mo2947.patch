@@ -32,14 +33,33 @@ def run(args, cwd, env):
     print('Running:', ' '.join(map(str,args)), flush=True)
     subprocess.run(list(map(str,args)), cwd=cwd, env=env, check=True)
 
+def brew_prefix(formula):
+    """Homebrew keg path on macOS, or None (Linux, or formula missing)."""
+    if sys.platform!='darwin':return None
+    try:return subprocess.check_output(['brew','--prefix',formula],text=True,stderr=subprocess.DEVNULL).strip() or None
+    except (OSError,subprocess.CalledProcessError):return None
+
+def host_setup(env):
+    """macOS: Homebrew's GNU bison/flex/texinfo/make come first on PATH (the system ones are too old), and GCC is told
+    where GMP/MPFR/MPC live (not on the default search path). Returns (make command, extra gcc configure flags)."""
+    if sys.platform!='darwin':return 'make',[]
+    paths=[f'{p}/bin' for p in map(brew_prefix,('bison','flex','texinfo','m4')) if p]
+    gmake=brew_prefix('make')
+    if gmake:paths.append(f'{gmake}/libexec/gnubin')
+    env['PATH']=os.pathsep.join(paths+[env['PATH']])
+    extra=[f'--with-{name}={p}' for name,formula in (('gmp','gmp'),('mpfr','mpfr'),('mpc','libmpc'))
+           if (p:=brew_prefix(formula))]
+    return 'make',extra
+
