+#define APX_SPI_TRACE_LAUNCH_SECTOR 0x003fe000u
+#define APX_BATTERY_CALIBRATION_ADDRESS 0x1e28u /* MO2947 bootstrap: adc_to_mv calibration word */
+#define APX_BATTERY_OFFSET_MV 20u
+#define APX_SD_CLOCK_SOURCE_HZ 144000000u
+#define APX_SD_CLOCK_HZ 24000000u
