diff --git a/linker/mo2947.ld b/linker/mo2947.ld
new file mode 100644
index 0000000..80fc8ab
--- /dev/null
+++ b/linker/mo2947.ld
@@ -0,0 +1,34 @@
+/* MO2947 (AX3295B, 2 MiB SDRAM), flash-booted through the unchanged stock header and bootstrap.
+ * The boot ROM loads flash 0x2200.. (0x7A400 bytes) to 0x02000000 and the bootstrap calls 0x020004A8, so every
+ * file-backed section must end below 0x0207A400 and the bootstrap call target must sit exactly at 0x020004A8.
+ * The NOLOAD sections follow the image directly (cleared at start-up by apx_runtime_init / apx_spi_boot_prepare).
+ * Must match boards/mo2947/board_memory.h. */
+ENTRY(apx_spi_entry)
+MEMORY { RAM (rwx)  : ORIGIN = 0x02000000, LENGTH = 0x1fc000
+         STACK (rw) : ORIGIN = 0x021fc000, LENGTH = 16K }
+__heap_size = DEFINED(APX_HEAP_SIZE) ? APX_HEAP_SIZE : 16K;
+SECTIONS {
+ .entry 0x02000000 : { KEEP(*(.text.entry)) } > RAM
+ .bootstrap_call 0x020004a8 : { KEEP(*(.text.mo2947_bootstrap_call)) } > RAM
+ .text : ALIGN(4) { FILL(0x00000015) *(.text .text.*) } > RAM
+ .rodata : ALIGN(4) { *(.rodata .rodata.*) } > RAM
+ .fatfs_tables : ALIGN(4) { __fatfs_tables_start = .; __fatfs_tables_end = .; } > RAM
+ .data : ALIGN(4) { __data_start = .; *(.data .data.* .sdata .sdata.*) __data_end = .; } > RAM
+ __data_source = LOADADDR(.data);
+ __image_end = .;
+ __extra_ram_start = 0; __extra_ram_end = 0;
+ .bss (NOLOAD) : ALIGN(32) { __bss_start = .; *(.bss .bss.* .sbss .sbss.* COMMON) __bss_end = .; } > RAM
+ .extra_bss (NOLOAD) : ALIGN(32) { __extra_bss_start = .; *(.extra_bss .extra_bss.*) __extra_bss_end = .; } > RAM
+ .noinit (NOLOAD) : ALIGN(8) { *(.noinit .noinit.*) } > RAM
+ .heap (NOLOAD) : ALIGN(8) { __heap_start = .; . += __heap_size; __heap_end = .; } > RAM
+ __runtime_used_end = .;
+ .display_dma (NOLOAD) : ALIGN(32) { __display_dma_start = .; *(.display_dma) __display_dma_end = .; } > RAM
+ .large_buffer (NOLOAD) : ALIGN(32) { __large_buffer_start = .; *(.large_buffer) __large_buffer_end = .; } > RAM
+ .jpeg_buffer (NOLOAD) : ALIGN(32) { __jpeg_buffer_start = .; *(.jpeg_buffer) __jpeg_buffer_end = .; } > RAM
+ __ram_used_end = .;
+ .stack (NOLOAD) : { __stack_bottom = .; . += LENGTH(STACK); __stack_top = .; } > STACK
+ /DISCARD/ : { *(.eh_frame*) *(.comment) *(.note*) }
+}
+ASSERT(mo2947_bootstrap_call == 0x020004a8, "bootstrap call target must be at 0x020004a8")
+ASSERT(SIZEOF(.entry) <= 0x4a8, "start-up code overlaps the bootstrap call target")
+ASSERT(__image_end <= 0x0207a400, "image larger than the 0x7A400 bytes the stock header loads")
