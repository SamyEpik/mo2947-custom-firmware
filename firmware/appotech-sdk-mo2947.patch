diff --git a/boards/mo2947/board_memory.h b/boards/mo2947/board_memory.h
new file mode 100644
index 0000000..b8feef2
--- /dev/null
+++ b/boards/mo2947/board_memory.h
@@ -0,0 +1,24 @@
+/* MO2947: 2 MiB SDR SDRAM at 0x02000000 (the stock bootstrap's stack top is 0x021FFFFC). The image is flashed at
+ * 0x2200 and loaded by the boot ROM to 0x02000000 (header: 0x7A400 bytes); the bootstrap calls 0x020004A8.
+ * linker/mo2947.ld packs bss, heap and the NOLOAD buffers right after the image (the rest of the ROM's load window is
+ * free once our code runs), stack at the top. The bounds below follow the linker symbols. */
+#ifndef __ASSEMBLER__
+#include <stdint.h>
+extern unsigned char __heap_end[],__display_dma_start[],__display_dma_end[],__large_buffer_start[],__large_buffer_end[],
+                     __jpeg_buffer_start[],__jpeg_buffer_end[];
+#endif
+#define APX_RAM_BASE 0x02000000u
+#define APX_RAM_END 0x02200000u
+#define APX_IMAGE_END 0x0207a400u
+#define APX_RUNTIME_BASE 0x02000000u
+#define APX_RUNTIME_END ((uintptr_t)__heap_end)
+#define APX_LCD_DMA_BASE ((uintptr_t)__display_dma_start)
+#define APX_LCD_DMA_END ((uintptr_t)__display_dma_end)
+#define APX_LOW_RAM_BASE ((uintptr_t)__large_buffer_start)
+#define APX_LOW_RAM_END ((uintptr_t)__large_buffer_end)
+#define APX_CODEC_RAM_BASE ((uintptr_t)__jpeg_buffer_start)
+#define APX_CODEC_RAM_END ((uintptr_t)__jpeg_buffer_end)
+#define APX_EXTRA_RAM_BASE 0x02000000u /* no separate extra bank (empty range): that code is part of the image */
+#define APX_EXTRA_RAM_END 0x02000000u
+#define APX_STACK_BASE 0x021fc000u
+#define APX_STACK_END 0x02200000u
diff --git a/boards/mo2947/early.c b/boards/mo2947/early.c
new file mode 100644
index 0000000..a2a1c8d
--- /dev/null
+++ b/boards/mo2947/early.c
@@ -0,0 +1,35 @@
+/* MO2947 early escape, run before any SDK code (no .bss/.data, caches off, bootstrap stack).
+ * Copied from firmware/mo2947-hello (verified on the device 2026-11-12): power hold as stock pm_power_hold +
+ * pm_domain_init, then SHUTTER (ADC channel 3 below 30, twice 30 ms apart) -> return 2 for the USB loader. */
+#include <stdint.h>
+static inline void w(uint32_t n,uint32_t v){__asm__ volatile("l.mtspr %0,%1,0"::"r"(n),"r"(v):"memory");}
+static inline uint32_t r(uint32_t n){uint32_t v;__asm__ volatile("l.mfspr %0,%1,0":"=r"(v):"r"(n):"memory");return v;}
+static void pm_wait(void){uint32_t t=0x8000;while((r(0x88e0)&8)&&--t){}}
+static void pm_tx(uint32_t b){w(0x88ec,b&255);pm_wait();}
+static void pm_wr(uint32_t c,uint32_t v){w(0x88e0,r(0x88e0)|0x100);pm_tx(c);pm_tx(v);w(0x88e0,r(0x88e0)&~0x100u);}
+static uint32_t pm_rd(uint32_t c){w(0x88e0,r(0x88e0)|0x100);pm_tx(c);w(0x88ec,0);pm_wait();uint32_t v=r(0x88ec)&255;w(0x88e0,r(0x88e0)&~0x100u);return v;}
+static void delay_ms(uint32_t ms){
+    uint32_t need=ms<<5,acc=0,guard=0,last=r(0x9804),cap=(need<<10)+100000;
+    while(acc<need&&++guard<cap){uint32_t now=r(0x9804);acc+=(now-last)&0x3fff;last=now;}
+}
+static int shutter(void){
+    w(0x8840,r(0x8840)&~(1u<<29));w(0x9170,0x13);w(0x9174,71);w(0x9170,r(0x9170)|0x80);
+    uint32_t t=0x8ffff;while((r(0x9170)&0x40)&&--t){}
+    return (r(0x9178)&0x3ff)<30;
+}
+__attribute__((used,noinline,section(".text.mo2947_early"))) int mo2947_early(void){
+    /* Record the clock state the bootstrap leaves, for reading through the loader: SRAM 0x2e80 =
+     * 'CLK0', 0x8858, 0x885c, 0x9800, 0x9808, 0x880c, 0x8840, 0x8844, 0x8864. */
+    volatile uint32_t *rec=(volatile uint32_t *)0x2e80u;
+    static const uint16_t sprs[8]={0x8858,0x885c,0x9800,0x9808,0x880c,0x8840,0x8844,0x8864};
+    for(unsigned i=0;i<8;++i)rec[1+i]=r(sprs[i]);
+    rec[0]=0x304b4c43u;
+    w(0x88e0,r(0x88e0)|0x40);pm_wr(0x41,0x0e);
+    pm_wr(0x43,0xe0);pm_wr(0x45,0);pm_wr(0x59,pm_rd(0x58)|8);pm_wr(0x41,pm_rd(0x40)|0x10);pm_wr(0x5b,8);
+    if(!shutter())return 0;
+    delay_ms(30);
+    if(!shutter())return 0;
+    w(0x880c,0x5500);                 /* as stock 0xDA: watchdog off, SPR 0x18 bits 1,2,14 cleared */
+    w(0x18,r(0x18)&~0x4006u);
+    return 2;
+}
diff --git a/boards/mo2947/entry.S b/boards/mo2947/entry.S
new file mode 100644
index 0000000..f0e58c4
--- /dev/null
+++ b/boards/mo2947/entry.S
@@ -0,0 +1,27 @@
+/* The unchanged stock bootstrap calls 0x020004A8 (flash 0x528/0x52C) after its SDRAM init, with r1 = 0x021FFFFC.
+ * 1. mo2947_early(): power hold and SHUTTER check with raw SPR code only (the path proven by mo2947-hello).
+ *    If it returns 2, return 2 to the bootstrap -> boot ROM USB loader, before any SDK code has run.
+ * 2. Otherwise restore r1/r2/r9 exactly and jump to the SDK's cold-boot entry (it saves them in apx_boot_context). */
+    .nodelay
+    .section .text.mo2947_bootstrap_call,"ax",@progbits
+    .global mo2947_bootstrap_call
+mo2947_bootstrap_call:
+    l.j     mo2947_entry_body
+    l.nop
+    .section .text.mo2947_entry_body,"ax",@progbits
+mo2947_entry_body:
+    l.addi  r1,r1,-16
+    l.sw    0(r1),r9
+    l.sw    4(r1),r2
+    l.jal   mo2947_early
+    l.nop
+    l.lwz   r9,0(r1)
+    l.lwz   r2,4(r1)
+    l.addi  r1,r1,16
+    l.sfeqi r11,2
+    l.bf    1f
+    l.nop
+    l.j     apx_spi_entry
+    l.nop
+1:  l.jr    r9              /* r11 = 2: back to the bootstrap, which enters the USB loader */
+    l.nop
diff --git a/boards/mo2947/gen_panel.py b/boards/mo2947/gen_panel.py
new file mode 100644
index 0000000..b4269ca
--- /dev/null
+++ b/boards/mo2947/gen_panel.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Write panel.inc (display_st7789.c format: {operation, value} pairs) from the owner's flash dump.
+Stock NV3030B table at flash 0x7C884 (0x418 bytes, u32 LE pairs, op 0 cmd / 1 data / 3 delay ms, 0xFFFFFFFF end).
+INVON (0x21) is left out: with this driver's RGB565 data the stock INVON shows inverted colours (seen on the device).
+The trailing RAMWR is left out: the driver opens its own window. Output is vendor data: keep it private.
+Run: python3 -I gen_panel.py DUMP panel.inc"""
+import struct, sys
+TABLE, LENGTH = 0x7C884, 0x418
+flash = open(sys.argv[1], 'rb').read()
+words = struct.unpack_from(f'<{LENGTH // 4}I', flash, TABLE)
+steps = []
+for op, val in zip(words[0::2], words[1::2]):
+    if op == 0xFFFFFFFF:
+        break
+    assert op in (0, 1, 3), op
+    steps.append((op, val))
+else:
+    sys.exit('no end marker')
+assert steps[-1] == (0, 0x2C) and (0, 0x21) in steps and (0, 0x29) in steps
+steps = [s for s in steps[:-1] if s != (0, 0x21)]
+with open(sys.argv[2], 'w') as f:
+    f.write('/* Generated by boards/mo2947/gen_panel.py from the owner\'s dump (flash 0x7C884). Vendor data: do not publish. */\n')
+    for op, val in steps:
+        f.write(f'    {{{op}u,0x{val:x}u}},\n')
+print(f'{len(steps)} steps')
