+# mo2947.ld overlaps .uvc_ws with .jpeg_buffer on purpose; its own asserts replace the overlap check.
+comma := ,
+BOARD_LDFLAGS := $(if $(filter mo2947,$(BOARD)),-Wl$(comma)--no-check-sections)
